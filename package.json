{
  "name": "art-scraper",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "setup": "pnpm install && pnpm infra && pnpm db:push",
    "infra": "docker compose up -d",
    "infra:down": "docker compose down",
    "db:push": "pnpm --filter api exec prisma db push",
    "db:studio": "pnpm --filter api exec prisma studio",
    "api": "pnpm --filter api run dev",
    "persister": "pnpm --filter img-persister run start",
    "crawl": "pnpm --filter crawler run crawl",
    "nats": "pnpm --filter crawler run nats",
    "dashboard": "pnpm --filter dashboard run dev",
    "build:ext": "cd packages/web-extension && zip -r ../../web-extension.zip ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.26.2"
}
